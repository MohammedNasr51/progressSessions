# MongoDB Atlas connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brightpath

# A long random value used to protect create/update/delete routes.
ADMIN_KEY=replace-with-a-long-random-secret

# Comma-separated websites allowed to call the API.
# Add both the GitHub Pages URL and localhost while developing.
ALLOWED_ORIGINS=https://mohammednasr51.github.io,http://127.0.0.1:5500,http://localhost:5500

# Used by Node locally. Deno Deploy supplies its own port.
PORT=8000
